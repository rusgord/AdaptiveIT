@model AdaptiveIT.Models.TestAttempt
@using AdaptiveIT.Models

@{
    ViewData["Title"] = "Результат тесту";

    double totalMaxPoints = Model.Answers?.Sum(a => a.Question?.Points ?? 0) ?? 0;
    double totalEarned = Model.Answers?.Sum(a => a.AwardedPoints) ?? 0;
}

<div class="row mt-4 mb-5 animate-fade-up">
    <div class="col-md-9 mx-auto">
        <div class="card card-modern border-0 p-md-4 shadow-lg text-center" style="background-color: var(--surface);">
            <div class="card-body">
                <div class="mb-4 animate-fade-up delay-100" style="font-size: 5rem; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.2));">
                    @if (Model.FinalScore >= 90)
                    {
                        <span>🏆</span>
                    }
                    else if (Model.FinalScore >= 70)
                    {

                        <span>👍</span>
                    }
                    else if (Model.FinalScore >= 50)
                    {

                        <span>😐</span>
                    }
                    else
                    {

                        <span>😢</span>
                    }
                </div>

                <h2 class="card-title text-white fw-bold animate-fade-up delay-100">Тест завершено!</h2>
                <p class="fs-5 mb-5" style="color: var(--text-muted);">"@Model.Test?.Title"</p>

                <div class="display-1 fw-bold animate-fade-up delay-200 mb-5" style="color: var(--primary); text-shadow: 0 0 30px rgba(99, 102, 241, 0.3);">
                    @totalEarned <span class="fs-4 text-muted">/ @totalMaxPoints балів</span>
                </div>

                <div class="row g-3 mb-5 animate-fade-up delay-300">
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 border" style="background-color: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.05) !important;">
                            <div class="small text-uppercase fw-bold mb-2" style="color: var(--text-muted);">Всього питань</div>
                            <div class="fs-4 text-white fw-bold">@Model.Answers?.Count</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 border" style="background-color: rgba(16, 185, 129, 0.05); border-color: rgba(16, 185, 129, 0.2) !important;">
                            <div class="small text-uppercase fw-bold mb-2" style="color: #10b981;">Повністю Правильних</div>
                            <div class="fs-4 fw-bold" style="color: #10b981;">@Model.Answers?.Count(a => a.IsCorrect)</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 border" style="background-color: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.05) !important;">
                            <div class="small text-uppercase fw-bold mb-2" style="color: var(--text-muted);">Витрачено часу</div>
                            <div class="fs-4 text-white fw-bold">
                                @if (Model.EndTime.HasValue)
                                {
                                    @Math.Round((Model.EndTime.Value - Model.StartTime).TotalMinutes, 1)
                                    <span class="fs-6">хв.</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.Test != null && Model.Test.ShowAnswersOnFinish)
                {
                    <hr class="my-5" style="border-color: var(--border-color);" />
                    <h4 class="mb-4 text-start text-white fw-bold animate-fade-up delay-300">Деталізація ваших відповідей:</h4>

                    <div class="d-flex flex-column gap-4 text-start animate-fade-up delay-300">
                        @if (Model.Answers != null)
                        {
                            foreach (var ans in Model.Answers)
                            {
                                bool isLongQuestion = ans.Question?.Type == QuestionType.LongAnswer;
                                bool isPendingReview = isLongQuestion && !ans.IsManuallyGraded;
                                bool isFullyCorrect = ans.IsCorrect || (ans.IsManuallyGraded && ans.AwardedPoints >= (ans.Question?.Points ?? 0) && (ans.Question?.Points ?? 0) > 0);
                                bool isPartial = !isPendingReview && !isFullyCorrect && ans.AwardedPoints > 0;

                                string mainBorderColor = isPendingReview ? "#f59e0b" : (isFullyCorrect ? "#10b981" : (isPartial ? "#fcd34d" : "#ef4444"));

                                <div class="p-4 p-md-5 rounded-4 shadow-sm" style="background-color: rgba(255,255,255,0.015); border-top: 4px solid @mainBorderColor; border-left: 1px solid var(--border-color); border-right: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">

                                    <h4 class="fw-bold mb-4 text-white lh-base">@ans.Question?.Text</h4>

                                    @if (!string.IsNullOrEmpty(ans.Question?.ImageUrl) && ans.Question?.Type != QuestionType.GraphicDragAndDrop)
                                    {
                                        <div class="text-center mb-4 p-3 rounded-3" style="background-color: rgba(0,0,0,0.2); border: 1px dashed rgba(255,255,255,0.1);">
                                            <img src="@ans.Question.ImageUrl" class="img-fluid rounded shadow-sm" style="max-height: 350px; object-fit: contain;" />
                                        </div>
                                    }

                                    @if (ans.Question?.Type == QuestionType.SingleChoice || ans.Question?.Type == QuestionType.MultipleChoice)
                                    {
                                        var userAnswers = string.IsNullOrEmpty(ans.AnswerDetails) ? new List<string>() : ans.AnswerDetails.Split(", ", StringSplitOptions.RemoveEmptyEntries).ToList();
                                        string checkIcon = ans.Question.Type == QuestionType.SingleChoice ? "🔘" : "☑️";

                                        <div class="list-group gap-3 mt-3">
                                            @foreach (var opt in ans.Question!.AnswerOptions!)
                                            {
                                                bool isSelected = userAnswers.Contains(opt.Text);
                                                bool isCorrectOption = opt.IsCorrect;

                                                string itemBg = isSelected ? (isCorrectOption ? "rgba(16, 185, 129, 0.15)" : "rgba(239, 68, 68, 0.15)") : "rgba(255,255,255,0.02)";
                                                string itemBorder = isSelected ? (isCorrectOption ? "#10b981" : "#ef4444") : "rgba(255,255,255,0.1)";
                                                string iconStatus = isSelected ? (isCorrectOption ? "✅" : "❌") : (isCorrectOption ? "✔️ (Пропущено)" : "");
                                                string iconColor = isCorrectOption ? "#10b981" : "#ef4444";

                                                <div class="list-group-item d-flex align-items-center p-3 rounded-3" style="background-color: @itemBg; border: 1px solid @itemBorder; color: var(--text-main);">
                                                    <span class="me-3 fs-5">@checkIcon</span>
                                                    <span class="flex-grow-1 fs-5">@opt.Text</span>
                                                    @if (!string.IsNullOrEmpty(iconStatus))
                                                    {
                                                        <span class="ms-3 small fw-bold" style="color: @iconColor;">@iconStatus</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (ans.Question?.Type == QuestionType.Ordering)
                                    {
                                        var userOrder = string.IsNullOrEmpty(ans.AnswerDetails) || ans.AnswerDetails == "Відповідь не надано" ? new List<string>() : ans.AnswerDetails.Split(" ➔ ", StringSplitOptions.RemoveEmptyEntries).ToList();
                                        var correctOrder = ans.Question!.AnswerOptions!.OrderBy(o => o.Id).Select(o => o.Text).ToList();

                                        <div class="row g-4 mt-3">
                                            <div class="col-md-6">
                                                <h6 class="small text-uppercase fw-bold mb-3" style="color: var(--text-muted);">Ваш порядок:</h6>
                                                <div class="list-group gap-2">
                                                    @for (int i = 0; i < userOrder.Count; i++)
                                                    {
                                                        bool isCorrectPos = i < correctOrder.Count && userOrder[i] == correctOrder[i];
                                                        string ordBg = isCorrectPos ? "rgba(16, 185, 129, 0.1)" : "rgba(239, 68, 68, 0.1)";
                                                        string ordBorder = isCorrectPos ? "#10b981" : "#ef4444";
                                                        <div class="list-group-item p-3 rounded-3" style="background-color: @ordBg; border: 1px solid @ordBorder; color: var(--text-main);">
                                                            <strong class="me-2 text-muted fs-5">☰</strong> <span class="fs-5">@userOrder[i]</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            @if (!isFullyCorrect)
                                            {
                                                <div class="col-md-6">
                                                    <h6 class="small text-uppercase fw-bold mb-3" style="color: #10b981;">Правильний порядок:</h6>
                                                    <div class="list-group gap-2">
                                                        @for (int i = 0; i < correctOrder.Count; i++)
                                                        {
                                                            <div class="list-group-item p-3 rounded-3" style="background-color: rgba(16, 185, 129, 0.05); border: 1px dashed rgba(16, 185, 129, 0.5); color: var(--text-main);">
                                                                <strong class="me-2 text-success fs-5">@(i + 1).</strong> <span class="fs-5">@correctOrder[i]</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (ans.Question?.Type == QuestionType.TextMatch)
                                    {
                                        var userMatches = string.IsNullOrEmpty(ans.AnswerDetails) || ans.AnswerDetails == "Відповідь не надано" ? new string[0] : ans.AnswerDetails.Split(" | ", StringSplitOptions.RemoveEmptyEntries);

                                        <div class="row g-4 mt-3">
                                            <div class="col-md-6">
                                                <h6 class="small text-uppercase fw-bold mb-3" style="color: var(--text-muted);">Ваші відповідності:</h6>
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (var match in userMatches)
                                                    {
                                                        var parts = match.Split(" ➔ ");
                                                        if (parts.Length == 2)
                                                        {
                                                            var term = parts[0];
                                                            var userTarget = parts[1];
                                                            var correctTarget = ans.Question!.AnswerOptions!.FirstOrDefault(o => o.Text == term)?.MatchTarget;
                                                            bool isMatchCorrect = userTarget == correctTarget;

                                                            string matchBg = isMatchCorrect ? "rgba(16, 185, 129, 0.1)" : "rgba(239, 68, 68, 0.1)";
                                                            string matchBorder = isMatchCorrect ? "#10b981" : "#ef4444";

                                                            <div class="p-3 rounded-3 d-flex justify-content-between align-items-center" style="background-color: @matchBg; border: 1px solid @matchBorder;">
                                                                <span class="fs-5"><span class="text-white fw-bold">@term</span> ➔ @userTarget</span>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>

                                            @if (!isFullyCorrect)
                                            {
                                                <div class="col-md-6">
                                                    <h6 class="small text-uppercase fw-bold mb-3" style="color: #10b981;">Правильні відповідності:</h6>
                                                    <div class="d-flex flex-column gap-2">
                                                        @foreach (var opt in ans.Question!.AnswerOptions!)
                                                        {
                                                            <div class="p-3 rounded-3 d-flex justify-content-between align-items-center" style="background-color: rgba(16, 185, 129, 0.05); border: 1px dashed rgba(16, 185, 129, 0.5);">
                                                                <span class="fs-5"><span class="text-white fw-bold">@opt.Text</span> ➔ <span class="text-success">@opt.MatchTarget</span></span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (ans.Question?.Type == QuestionType.GraphicDragAndDrop)
                                    {
                                        <div class="mt-4 text-center">
                                            <div class="d-inline-block position-relative rounded-3 p-2 shadow-lg" style="background-color: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                                                <img src="@ans.Question.ImageUrl" class="img-fluid rounded" style="max-height: 450px;" />
                                                @if (ans.Question.GraphicMatchZones != null)
                                                {
                                                    foreach (var zone in ans.Question.GraphicMatchZones)
                                                    {
                                                        string zoneColor = ans.IsCorrect ? "#10b981" : "#ef4444";
                                                        string zoneBg = ans.IsCorrect ? "rgba(16, 185, 129, 0.3)" : "rgba(239, 68, 68, 0.4)";

                                                        <div style="position: absolute; left: @zone.PositionX%; top: @zone.PositionY%; width: @zone.Width%; height: @zone.Height%; border: 2px solid @zoneColor; background-color: @zoneBg; transform: translate(-50%, -50%); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: bold; color: white; backdrop-filter: blur(2px);">
                                                            @zone.CorrectFragment
                                                        </div>
                                                    }
                                                }
                                            </div>
                                            @if (!ans.IsCorrect)
                                            {
                                                <div class="alert mt-3 mb-0 border-0 text-center" style="background-color: rgba(239,68,68,0.1); color: #fca5a5;">
                                                    У розстановці блоків були допущені помилки. Вище показані правильні позиції (куди треба було перетягнути блоки).
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (ans.Question?.Type == QuestionType.ShortAnswer)
                                    {
                                        string shortBorder = ans.IsCorrect ? "#10b981" : "#ef4444";
                                        <div class="mt-3">
                                            <h6 class="small text-uppercase fw-bold mb-3" style="color: var(--text-muted);">Ваша відповідь:</h6>
                                            <input type="text" class="form-control form-control-lg shadow-none py-3" style="background-color: rgba(255,255,255,0.03); border: 1px solid @shortBorder; color: var(--text-main); font-size: 1.1rem;" value="@ans.AnswerDetails" disabled />

                                            @if (!ans.IsCorrect)
                                            {
                                                <div class="p-3 rounded-3 mt-3" style="background-color: rgba(16, 185, 129, 0.05); border: 1px dashed rgba(16, 185, 129, 0.5);">
                                                    <small class="d-block mb-1 text-uppercase fw-bold" style="color: #10b981;">Правильні варіанти:</small>
                                                    <span class="text-success fs-5">@string.Join(" АБО ", ans.Question!.AnswerOptions!.Where(o => o.IsCorrect).Select(o => o.Text))</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (ans.Question?.Type == QuestionType.LongAnswer)
                                    {
                                        <div class="mt-3">
                                            <h6 class="small text-uppercase fw-bold mb-3" style="color: var(--text-muted);">Ваша відповідь:</h6>
                                            <textarea class="form-control shadow-none font-monospace p-4" rows="6" style="background-color: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); color: #38bdf8; font-size: 1.05rem; resize: vertical;" disabled>@ans.AnswerDetails</textarea>
                                        </div>
                                    }

                                    <hr class="mt-4 mb-3" style="border-color: rgba(255,255,255,0.05);" />

                                    <div class="d-flex flex-column gap-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            @if (isPendingReview)
                                            {
                                                <span class="badge rounded-pill px-3 py-2 fs-6" style="background-color: rgba(245, 158, 11, 0.15); color: #fcd34d;">⏳ На перевірці викладачем</span>
                                            }
                                            else if (isPartial)
                                            {
                                                <span class="badge rounded-pill px-3 py-2 fs-6 bg-warning text-dark">⚠️ Частково правильно (@ans.AwardedPoints / @ans.Question?.Points балів)</span>
                                            }
                                            else if (isFullyCorrect)
                                            {
                                                <span class="badge rounded-pill px-3 py-2 fs-6" style="background-color: rgba(16, 185, 129, 0.15); color: #10b981;">✅ Правильно (@ans.AwardedPoints балів)</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill px-3 py-2 fs-6" style="background-color: rgba(239, 68, 68, 0.15); color: #ef4444;">❌ Помилка (0 балів)</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrEmpty(ans.TeacherFeedback))
                                        {
                                            <div class="p-3 rounded-3 mt-2" style="background-color: rgba(99, 102, 241, 0.1); border-left: 4px solid var(--primary);">
                                                <div class="small text-uppercase fw-bold mb-2" style="color: var(--primary);">👨‍🏫 Коментар викладача:</div>
                                                <div class="text-white" style="white-space: pre-wrap; font-size: 0.95rem;">@ans.TeacherFeedback</div>
                                            </div>
                                        }
                                    </div>

                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="alert mt-4 border-0 rounded-3 text-start" style="background-color: rgba(255,255,255,0.05); color: var(--text-muted);">
                        🔒 Викладач приховав детальну статистику відповідей для цього тесту.
                    </div>
                }

                <div class="mt-5">
                    <a asp-action="Index" class="btn btn-primary-modern btn-lg px-5 py-3 shadow-lg">Повернутися до кабінету</a>
                </div>
            </div>
        </div>
    </div>
</div>