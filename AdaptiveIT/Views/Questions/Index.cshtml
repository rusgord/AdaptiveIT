@model IEnumerable<AdaptiveIT.Models.Question>

@{
    ViewData["Title"] = "Питання тесту";
    int testId = ViewBag.TestId;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mt-4 mb-5 animate-fade-up gap-3">
    <div>
        <a asp-controller="Tests" asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3 rounded-pill px-3">← Назад до тестів</a>
        <h2 class="fw-bold text-white mb-1">Питання: @ViewBag.TestTitle</h2>
        <p style="color: var(--text-muted); mb-0">Керуйте питаннями та варіантами відповідей.</p>
    </div>
    <a asp-action="Create" asp-route-testId="@testId" class="btn btn-primary-modern px-4 py-2 shadow-sm d-flex align-items-center gap-2">
        <span>Додати питання</span> <span>➕</span>
    </a>
</div>

<div class="card card-modern border-0 animate-fade-up delay-100">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0" style="--bs-table-bg: transparent; --bs-table-color: var(--text-main); --bs-table-border-color: var(--border-color); --bs-table-hover-bg: rgba(255,255,255,0.02);">
                <thead style="background-color: rgba(255,255,255,0.02);">
                    <tr>
                        <th class="text-uppercase small text-muted px-4 py-3">Текст питання</th>
                        <th class="text-uppercase small text-muted py-3">Тип</th>
                        <th class="text-uppercase small text-muted py-3">Складність</th>
                        <th class="text-uppercase small text-muted text-end px-4 py-3">Дії</th>
                    </tr>
                </thead>
                <tbody class="table-group-divider" style="border-top-color: var(--border-color);">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5" style="color: var(--text-muted);">
                                <div class="fs-1 mb-3">📭</div>
                                У цьому тесті ще немає питань.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr class="table-hover">
                                <td class="px-4 py-3 fw-bold text-white">
                                    <div style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@item.Text">
                                        @item.Text
                                    </div>
                                </td>
                                <td>
                                    <span class="badge" style="background-color: var(--background); border: 1px solid var(--border-color); color: var(--text-muted);">@item.Type</span>
                                </td>
                                <td>
                                    <span class="badge badge-soft-primary px-3 py-1 rounded-pill">Рівень: @item.DifficultyLevel</span>
                                </td>
                                <td class="text-end px-4 py-3">
                                    <div class="btn-group shadow-sm rounded-3">
                                        <a asp-action="ManageAnswers" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" style="border-color: var(--border-color); color: #f59e0b;">Налаштувати відповіді</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light" style="border-color: var(--border-color); color: var(--text-muted);">Редагувати</a>
                                    </div>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline ms-2" onsubmit="return confirm('Ви впевнені, що хочете видалити це питання? Усі відповіді також будуть видалені.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" style="border-color: transparent;">🗑️</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>