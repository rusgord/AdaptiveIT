@model AdaptiveIT.Models.Group

@{
    ViewData["Title"] = "Склад групи " + Model.Name;
}

<div class="container mt-4 mb-5 animate-fade-up">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3 rounded-pill px-3">← Назад до груп</a>
            <h3 class="fw-bold text-white mb-1">Склад групи: @Model.Name</h3>
            <p style="color: var(--text-muted);" class="mb-2">Код для приєднання нових студентів: <strong style="color: #10b981;">@Model.InviteCode</strong></p>
        </div>
        <div class="badge badge-soft-primary px-4 py-3 rounded-3 shadow-sm fs-5 border border-primary border-opacity-25">
            Всього учасників: @(Model.Students?.Count ?? 0)
        </div>
    </div>

    <div class="card card-modern border-0 animate-fade-up delay-100">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="--bs-table-bg: transparent; --bs-table-color: var(--text-main); --bs-table-border-color: var(--border-color); --bs-table-hover-bg: rgba(255,255,255,0.02);">
                    <thead style="background-color: rgba(255,255,255,0.02);">
                        <tr>
                            <th class="px-4 py-3 text-muted small text-uppercase">Студент</th>
                            <th class="py-3 text-muted small text-uppercase">Email</th>
                            <th class="text-end px-4 py-3 text-muted small text-uppercase">Дії</th>
                        </tr>
                    </thead>
                    <tbody class="table-group-divider" style="border-top-color: var(--border-color);">
                        @if (Model.Students == null || !Model.Students.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5" style="color: var(--text-muted);">
                                    <div class="fs-1 mb-3">📭</div>
                                    У цій групі ще немає жодного студента. Передайте їм код запрошення.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var student in Model.Students)
                            {
                                <tr class="table-hover" style="transition: background-color 0.3s;">
                                    <td class="px-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <img src="@(student.AvatarUrl ?? "/uploads/avatars/default-avatar.png")" class="rounded-circle me-3 border" style="width: 40px; height: 40px; object-fit: cover; border-color: var(--border-color) !important;" alt="Avatar" />
                                            <span class="fw-bold text-white">@student.FullName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span style="color: var(--text-muted);">@student.Email</span>
                                    </td>
                                    <td class="text-end px-4 py-3">
                                        <form asp-action="RemoveStudent" method="post" onsubmit="return confirm('Виключити студента @student.FullName з групи? Його акаунт не буде видалено.');">
                                            <input type="hidden" name="groupId" value="@Model.Id" />
                                            <input type="hidden" name="studentId" value="@student.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm" style="background-color: rgba(239, 68, 68, 0.05);">
                                                Виключити ❌
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>