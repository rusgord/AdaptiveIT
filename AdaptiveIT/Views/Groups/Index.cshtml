@model IEnumerable<AdaptiveIT.Models.Group>

@{
    ViewData["Title"] = "Академічні групи";
}

<div class="d-flex justify-content-between align-items-center mb-5 mt-4 animate-fade-up">
    <div>
        <h2 class="fw-bold text-white mb-1">Академічні групи</h2>
        <p style="color: var(--text-muted);">Керування групами для налаштування доступів до тестів.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4 animate-fade-up delay-100">
        <div class="card card-modern border-0 sticky-top" style="top: 100px;">
            <div class="card-body p-4">
                <h5 class="fw-bold text-white mb-4">Створити групу</h5>
                <form asp-action="Create" method="post">
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold text-uppercase">Назва нової групи</label>
                        <input type="text" name="name" class="form-control form-control-lg shadow-none" style="background-color: var(--background); border-color: var(--border-color); color: var(--text-main);" placeholder="Наприклад: 641п" required />
                    </div>
                    <button type="submit" class="btn btn-primary-modern w-100 py-3">Додати групу ➕</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8 animate-fade-up delay-200">
        @if (!Model.Any())
        {
            <div class="text-center py-5" style="color: var(--text-muted);">
                Ще не створено жодної групи.
            </div>
        }

        @foreach (var group in Model)
        {
            <div class="card card-modern border-0 p-4 mb-3" style="background-color: var(--surface);">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <h5 class="fw-bold text-white mb-2">
                            @group.Name
                            <span class="badge badge-soft-primary rounded-pill px-3 py-1 ms-2">Студентів: @(group.Students?.Count ?? 0)</span>
                        </h5>

                        <div class="d-inline-flex align-items-center px-3 py-2 rounded-3 mt-1"
                             style="background-color: var(--background); border: 1px solid var(--border-color); cursor: pointer;"
                             onclick="copyToClipboard('@group.InviteCode')"
                             title="Натисніть, щоб скопіювати код">
                            <span class="small me-2" style="color: var(--text-muted);">Код запрошення:</span>
                            <span class="fw-mono fw-bold" style="color: #10b981; letter-spacing: 1px;">@group.InviteCode</span>
                            <span class="ms-2" style="font-size: 0.8rem; color: var(--primary);">📋</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-action="Details" asp-route-id="@group.Id" class="btn btn-sm btn-primary-modern rounded-pill px-4 py-2">
                            👥 Склад групи
                        </a>
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Видалити цю групу назавжди?');">
                            <input type="hidden" name="id" value="@group.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-2" style="width: 36px; height: 36px;">🗑️</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                const toast = document.createElement('div');
                toast.innerText = 'Код скопійовано: ' + text;
                toast.className = 'position-fixed bottom-0 end-0 p-3 m-3 bg-success text-white rounded shadow-sm';
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 2000);
            });
        }
    </script>
}