@model AdaptiveIT.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Новий пароль";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-5">
        <div class="card card-modern border-0 animate-fade-up">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="fs-1 mb-2">🔒</div>
                    <h3 class="fw-bold">Встановіть новий пароль</h3>
                </div>

                <form asp-action="ResetPassword" method="post">
                    <input asp-for="Token" type="hidden" />
                    <input asp-for="Email" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label text-muted small fw-bold text-uppercase">Новий пароль</label>
                        <input asp-for="Password" class="form-control form-control-lg shadow-none" style="background-color: var(--background); border-color: var(--border-color); color: var(--text-main);" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label text-muted small fw-bold text-uppercase">Підтвердження пароля</label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-lg shadow-none" style="background-color: var(--background); border-color: var(--border-color); color: var(--text-main);" placeholder="••••••••" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary-modern btn-lg w-100 py-3 shadow-sm">Зберегти пароль</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}