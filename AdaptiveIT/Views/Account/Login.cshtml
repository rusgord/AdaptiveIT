@model AdaptiveIT.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Вхід";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success small border-0 rounded-3 text-center mb-4" style="background-color: rgba(16, 185, 129, 0.1); color: #10b981;">
        ✅ @TempData["SuccessMessage"]
    </div>
}
<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-5">
        <div class="card card-modern border-0 animate-fade-up">
            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="fs-1 mb-2">🔐</div>
                    <h3 class="fw-bold">Вхід в систему</h3>
                    <p class="text-muted small">З поверненням! Увійдіть до свого акаунту.</p>
                </div>

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-muted small fw-bold text-uppercase">Email адреса</label>
                        <input asp-for="Email" class="form-control form-control-lg shadow-none" style="background-color: var(--background); border-color: var(--border-color); color: var(--text-main);" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label text-muted small fw-bold text-uppercase">Пароль</label>
                        <input asp-for="Password" class="form-control form-control-lg shadow-none" style="background-color: var(--background); border-color: var(--border-color); color: var(--text-main);" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input shadow-none" id="rememberMeCheck" style="background-color: var(--background); border-color: var(--border-color);" />
                            <label asp-for="RememberMe" class="form-check-label text-muted user-select-none" style="cursor: pointer;" for="rememberMeCheck">
                                Запам'ятати мене
                            </label>
                        </div>
                        <a asp-action="ForgotPassword" class="small fw-bold" style="color: var(--primary); text-decoration: none;">Забули пароль?</a>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary-modern btn-lg py-3 shadow-sm">Увійти до кабінету</button>
                    </div>

                </form>
            </div>

            <div class="card-footer bg-transparent border-top text-center py-4" style="border-color: var(--border-color) !important;">
                <div class="small text-muted">
                    Немає акаунта? <a asp-action="Register" style="color: var(--primary); text-decoration: none; font-weight: 600;">Зареєструватися</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}