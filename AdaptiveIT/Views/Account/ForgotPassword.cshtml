@model AdaptiveIT.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Забули пароль?";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-5">
        <div class="card card-modern border-0 animate-fade-up">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="fs-1 mb-3">🔑</div>
                <h3 class="fw-bold mb-2">Відновлення пароля</h3>
                <p class="text-muted small mb-4">Введіть email, який ви використовували при реєстрації, і ми надішлемо вам посилання для скидання пароля.</p>

                <form asp-action="ForgotPassword" method="post" class="text-start">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label text-muted small fw-bold text-uppercase">Email адреса</label>
                        <input asp-for="Email" class="form-control form-control-lg shadow-none" style="background-color: var(--background); border-color: var(--border-color); color: var(--text-main);" placeholder="name@example.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary-modern btn-lg w-100 py-3 shadow-sm">Відправити посилання</button>
                </form>
            </div>
            <div class="card-footer bg-transparent border-top text-center py-4" style="border-color: var(--border-color) !important;">
                <div class="small text-muted">
                    Згадали пароль? <a asp-action="Login" style="color: var(--primary); text-decoration: none; font-weight: 600;">Повернутися до входу</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}